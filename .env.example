# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

POSTGRES_HOST=db
POSTGRES_DB=p2pmon
POSTGRES_USER=p2pmon
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0

# Encrypts the exchange API keys stored in the DB. Never reuse a key from this file.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
TIME_ZONE=Europe/Moscow
SYNC_OVERLAP_DAYS=7

# First start only: the superuser is created from these (no built-in default).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
